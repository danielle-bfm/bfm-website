{
  "cleanUrls": true,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "betterfuturepod.com" }],
      "destination": "https://betterfuture.media/podcast",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.betterfuturepod.com" }],
      "destination": "https://betterfuture.media/podcast",
      "permanent": true
    }
  ]
}
